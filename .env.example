# Beispiel für Build / Vercel (keine echten Schlüssel committen!)
#
# Flutter lokal:
#   flutter run --dart-define=GROQ_API_KEY=gsk_... \
#               --dart-define=MISTRAL_API_KEY=... \
#               --dart-define=OPENROUTER_API_KEY=...
#
# Oder in der App unter Einstellungen → „Fallback bei Gemini-Limit“ speichern.
#
# Vercel / Web-Build (tool/vercel_build.sh): dart-define aus Env setzen.

GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
