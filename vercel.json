{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "chmod +x tool/vercel_build.sh && ./tool/vercel_build.sh",
  "outputDirectory": "build/web",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/flutter_service_worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
